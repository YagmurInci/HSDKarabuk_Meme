# ============================================
# MEME GUESSER - Environment Variables
# Her geliştirici bu dosyayı .env.local olarak kopyalayıp doldurmalıdır.
# cp .env.example .env.local
# ============================================

# Supabase PostgreSQL (Pooled connection - runtime)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase PostgreSQL (Direct connection - Prisma push/migrate için)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-eu-west-2.pooler.supabase.com:5432/postgres"

# Anti-Cheat Secret (openssl rand -hex 32)
GAME_SECRET="generate-with-openssl-rand-hex-32"

# Game Session TTL (milisaniye, default 5 dakika)
GAME_SESSION_TTL_MS="300000"

# Admin Panel Şifresi
ADMIN_PASSWORD="hackathon-admin-2026"
